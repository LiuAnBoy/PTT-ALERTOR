# PostgreSQL (required)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ptt-alert
# POSTGRES_POOL_SIZE=10

# Redis (required)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Redis db index (default 0). Set if sharing one Redis instance across services.
REDIS_DB=0

# Server (optional)
PORT=8000
NODE_ENV=development
# LOG_LEVEL=debug
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Telegram (required)
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=

# Telegram (optional)
# Your Telegram chat ID: receives FATAL/ERROR alerts directly, or as the fallback when SERVICE_KEY is set
ADMIN_TELEGRAM_ID=

# Admin alerts through Service Manager notify_service (optional; alerts go to ADMIN_TELEGRAM_ID when SERVICE_KEY is empty)
# This service's bearer key in Service Manager. A secret: never log or share it.
SERVICE_KEY=
# notify_service base URL (default http://127.0.0.1:5000)
# NOTIFY_SERVICE_URL=http://127.0.0.1:5000
# Admin channel slug that receives the alerts (default system_admin)
# NOTIFY_ADMIN_CHANNEL=system_admin

# PTT mail feature (optional; mail stays off unless BOTH of these and TELEGRAM_WEBHOOK_SECRET are set)
# Base64 of exactly 32 bytes, encrypts stored PTT passwords: openssl rand -base64 32
PTT_ENCRYPT_KEY=
# Max mails each user may send per day (Asia/Taipei), default 20
# MAIL_DAILY_LIMIT=20

# Telegram webhook secret (optional): A-Z a-z 0-9 _ - only, max 256 chars: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
