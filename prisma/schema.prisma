generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ───────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  enable        Boolean        @default(true)
  subscriptions Subscription[]
  channels      Channel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

// ─── Channel ──────────────────────────────────────────

enum Platform {
  TELEGRAM
}

model Channel {
  id             String   @id @default(uuid())
  platform       Platform
  platformUserId String
  platformChatId String
  username       String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([platform, platformUserId])
  @@map("channels")
}

// ─── Subscription ───────────────────────────────────

model Subscription {
  id      String @id @default(uuid())
  board   String
  keyword String
  userId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, board, keyword])
  @@index([board])
  @@map("subscriptions")
}

// ─── Article ────────────────────────────────────────

model Article {
  code      String   @id
  timestamp BigInt
  title     String
  link      String
  author    String?
  board     String
  ip        String?
  content   String?
  pushSum   Int      @default(0)
  positive  Int      @default(0)
  negative  Int      @default(0)
  neutral   Int      @default(0)
  comments  Json?

  createdAt   DateTime @default(now())
  expireAt    DateTime
  lastUpdated DateTime @default(now()) @updatedAt

  @@index([board, timestamp])
  @@index([expireAt])
  @@map("articles")
}

// ─── CrawlerLog ─────────────────────────────────────

enum LogLevel {
  WARN
  ERROR
  FATAL
}

model CrawlerLog {
  id        String   @id @default(uuid())
  level     LogLevel
  module    String
  message   String
  detail    Json?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@map("crawler_logs")
}
