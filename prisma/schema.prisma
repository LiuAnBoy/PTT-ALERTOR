generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ───────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  enable        Boolean        @default(true)
  username      String?
  email         String?
  phone         String?
  subscriptions Subscription[]
  channels      Channel[]
  pttAccount    PttAccount?
  mailRequests  MailRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

// ─── Channel ──────────────────────────────────────────

enum Platform {
  TELEGRAM
}

model Channel {
  id             String   @id @default(uuid())
  platform       Platform
  platformUserId String
  platformChatId String
  rawData        Json?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([platform, platformUserId])
  @@map("channels")
}

// ─── Subscription ───────────────────────────────────

model Subscription {
  id      String @id @default(uuid())
  board   String
  keyword String
  userId  String

  /// Mail text sent to the article author; null means mail is not offered.
  replyContent         String?
  replyIncludeOriginal Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, board, keyword])
  @@index([board])
  @@map("subscriptions")
}

// ─── Article ────────────────────────────────────────

model Article {
  code      String  @id
  timestamp BigInt
  title     String
  link      String
  author    String?
  board     String
  ip        String?
  content   String?
  pushSum   Int     @default(0)
  positive  Int     @default(0)
  negative  Int     @default(0)
  neutral   Int     @default(0)
  comments  Json?

  createdAt   DateTime @default(now())
  lastUpdated DateTime @default(now()) @updatedAt

  @@index([board, timestamp])
  @@map("articles")
}

// ─── CrawlerLog ─────────────────────────────────────

enum LogLevel {
  WARN
  ERROR
  FATAL
}

model CrawlerLog {
  id        String   @id @default(uuid())
  level     LogLevel
  module    String
  message   String
  detail    Json?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@map("crawler_logs")
}

// ─── PttAccount ─────────────────────────────────────

model PttAccount {
  id          String    @id @default(uuid())
  userId      String    @unique
  pttId       String
  /// AES-256-GCM ciphertext, format v1.<iv>.<tag>.<ct>
  passwordEnc String
  invalidAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ptt_accounts")
}

// ─── MailRequest ────────────────────────────────────

enum MailRequestStatus {
  OFFERED
  QUEUED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model MailRequest {
  id          String            @id @default(uuid())
  userId      String
  board       String
  articleCode String
  author      String
  title       String
  keyword     String
  status      MailRequestStatus @default(OFFERED)
  error       String?
  chatId      String?
  messageId   String?
  /// Successful claims so far; bounded by MAX_MAIL_ATTEMPTS
  attempts    Int               @default(0)
  queuedAt    DateTime          @default(now())
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleCode])
  @@index([status])
  @@map("mail_requests")
}
